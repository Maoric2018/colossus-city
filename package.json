{
  "name": "colossus-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asymmetric Quest 2 / laptop multiplayer with authoritative destructible-city physics",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/unit.test.js",
    "test:physics": "node --test tests/physics.test.js",
    "test:network": "node --test tests/network.test.js",
    "test:xr": "node --test tests/xr.test.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "quest:usb": "node scripts/quest-usb.mjs",
    "quest:check": "node scripts/quest-usb.mjs --check",
    "test:all": "node --test tests/*.test.js",
    "assets": "node scripts/fetch-assets.mjs",
    "check": "node scripts/check.mjs",
    "bench": "node scripts/benchmark.mjs",
    "test:visual": "node scripts/visual-smoke.mjs",
    "test:xr-view": "node scripts/xr-view-smoke.mjs",
    "test:ragdoll": "node scripts/ragdoll-smoke.mjs",
    "test:giant": "node scripts/giant-contact-smoke.mjs",
    "profile": "node scripts/profile.mjs",
    "profile:optimization": "node scripts/optimization-profile.mjs",
    "test:landmarks": "node scripts/landmark-smoke.mjs",
    "test:chrysler": "node scripts/chrysler-smoke.mjs",
    "test:city": "node scripts/city-smoke.mjs",
    "test:catalog": "node scripts/catalog-smoke.mjs",
    "test:world-landmarks": "node scripts/catalog-smoke.mjs --world",
    "test:streaming": "node scripts/streaming-smoke.mjs",
    "test:cars": "node scripts/car-smoke.mjs",
    "test:flight-animation": "node scripts/flight-animation-smoke.mjs",
    "test:fine-destruction": "node scripts/fine-destruction-smoke.mjs",
    "test:soar-breach": "node scripts/soar-breach-smoke.mjs",
    "test:fracture-render": "node scripts/fracture-render-smoke.mjs",
    "test:traffic": "node scripts/traffic-smoke.mjs",
    "test:streets": "node scripts/street-smoke.mjs",
    "profile:destruction": "node scripts/destruction-profile.mjs",
    "profile:destruction-render": "node scripts/destruction-render-profile.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.17.3",
    "three": "0.180.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "iwer": "2.4.0",
    "playwright": "1.63.0"
  }
}
